# Environment files
.env

idpbuilder.tar.gz

# Generated kubeconfigs (contain cluster credentials)
remote-kubeconfig.yaml

# Private keys - NEVER commit these
**/keys/sa.key
**/keys/sa.pub
**/jwks.json

# Talos cluster configs (contain PKI secrets)
talos-configs/
node_modules/tsx/dist/

node_modules/

# Temporary clone directories
temp-backstage-repo/
# Certificate cache (regenerated from cluster)
scripts/certificates/cache/
scripts/certificates/system/

# DevSpace
.devspace/
**/.devspace/logs/

# Kubeconfigs
**/kubeconfig.yaml
**/.kube/

# Legacy approaches (removed in kustomize migration)
cdk8s/
nixidy/
nixidy-dist/

# NixOS VM images (large binary files, built from Nix configs)
nixos-images/*.qcow2
nixos-images/*.iso
nixos-images/*.img

# Deployment runtime-generated config (keep templates, ignore generated files)
deployment/config/*
!deployment/config/kind-config.yaml.template

# Logs
*.log

# Backup files
*.bak
*.backup
*.tmp
*~
*.swp
*.orig

# Spec-kit (private credentials may be stored here)
.claude/
.specify/memory/

# OS files
.DS_Store
Thumbs.db

# Temporary debugging artifacts
argocd-*-screenshot.png

# devenv (Nix development environment)
.devenv/
.devenv.flake.nix
devenv.lock
result

# Kustomize packages build output
packages/dist/

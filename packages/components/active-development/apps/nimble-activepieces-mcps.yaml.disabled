apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: nimble-activepieces-mcps
  namespace: argocd
  annotations:
    argocd.argoproj.io/sync-wave: "88"
spec:
  project: default
  source:
    repoURL: cnoe://nimble-activepieces-mcps/manifests
    targetRevision: HEAD
    path: "."
  destination:
    server: https://kubernetes.default.svc
    namespace: workflow-builder
  syncPolicy:
    automated:
      selfHeal: true
      prune: true
    retry:
      limit: 10
      backoff:
        duration: 5s
        factor: 2
        maxDuration: 3m
    syncOptions:
      - CreateNamespace=true
      - SkipDryRunOnMissingResource=true

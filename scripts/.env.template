# Environment for Talos GitOps Bootstrap
# Feature: 102-bootstrap-talos-argocd
#
# This file configures Azure Workload Identity for External Secrets Operator
# and ArgoCD GitOps integration.
#
# =============================================================================
# QUICK START
# =============================================================================
#
# Option A: Fresh setup (creates all Azure resources)
#   1. Copy this file: cp .env.template .env
#   2. Set AZURE_SUBSCRIPTION_ID and AZURE_TENANT_ID below
#   3. Run: ./bootstrap-cluster.sh --setup-azure
#
# Option B: Existing Azure infrastructure
#   1. Copy this file: cp .env.template .env
#   2. Fill in all values below from your existing setup
#   3. Run: ./bootstrap-cluster.sh
#
# =============================================================================
# AZURE WORKLOAD IDENTITY
# =============================================================================
#
# How it works:
# - Kubernetes service accounts present JWTs to Azure AD
# - Azure AD validates the JWT against the OIDC issuer (storage account)
# - If valid and subject matches federated credential, Azure AD issues tokens
# - External Secrets Operator uses these tokens to access Key Vault
#
# Key components:
# - Azure Storage Account: Hosts OIDC discovery documents (JWKS)
# - Azure AD Application: Represents the workload in Azure
# - Federated Credentials: Link K8s service accounts to Azure AD app
# - Key Vault: Stores secrets accessed by ESO
#
# =============================================================================
# REQUIRED CONFIGURATION
# =============================================================================

# Azure subscription and tenant (required - get from: az account show)
AZURE_SUBSCRIPTION_ID=""
AZURE_TENANT_ID=""

# Azure AD Application Client ID (for Workload Identity)
# Created by 00-bootstrap-azure-infra.sh or use existing app
# Get with: az ad app list --display-name "gitops-talos" --query "[0].appId"
AZURE_CLIENT_ID=""

# Azure Key Vault name (without .vault.azure.net suffix)
# Contains secrets synced by External Secrets Operator
AZURE_KEYVAULT_NAME=""

# Azure Storage Account (for OIDC JWKS hosting)
# Static website endpoint serves the OIDC discovery documents
# Created by 00-bootstrap-azure-infra.sh with name like "oidcissuerXXXXXX"
AZURE_STORAGE_ACCOUNT=""

# OIDC Issuer URL (derived from storage account)
# Format: https://<storage-account>.z13.web.core.windows.net/
# Get with: az storage account show -n $AZURE_STORAGE_ACCOUNT --query "primaryEndpoints.web"
SERVICE_ACCOUNT_ISSUER=""

# =============================================================================
# GIT REPOSITORY
# =============================================================================

# Git repository URL for ArgoCD (must be accessible from cluster)
GIT_REPO_URL="https://github.com/PittampalliOrg/stacks.git"

# Git branch containing CDK8s manifests
GIT_BRANCH="106-consolidate-bootstrap-between"

# Path to CDK8s dist directory (relative to repo root, NOT branch name prefix!)
# IMPORTANT: Do NOT include branch name in path. The branch is specified above.
# Wrong: "106-consolidate-bootstrap-between/cdk8s/dist" (branch prefix)
# Right: "cdk8s/dist" (path within the branch)
GIT_PATH="cdk8s/dist"

# =============================================================================
# OPTIONAL CONFIGURATION
# =============================================================================

# Tailscale tailnet for remote access (e.g., "tail286401")
# Access URLs: https://svc-argocd.<tailnet>.ts.net
TAILSCALE_TAILNET=""

# ArgoCD Helm chart version
ARGOCD_CHART_VERSION="7.3.0"


# Environment Template for Talos GitOps Bootstrap
# Feature: 102-bootstrap-talos-argocd
#
# Copy this file to .env and fill in your values:
#   cp .env.template .env
#
# Required for all operations:
# ────────────────────────────────────────────────────────────────

# Azure subscription and tenant
AZURE_SUBSCRIPTION_ID="your-subscription-id"
AZURE_TENANT_ID="your-tenant-id"

# Azure AD Application (for Workload Identity)
AZURE_CLIENT_ID="your-app-client-id"

# Azure Key Vault (secrets storage)
AZURE_KEYVAULT_NAME="your-keyvault-name"

# Azure Storage Account (for OIDC JWKS hosting)
AZURE_STORAGE_ACCOUNT="your-storage-account"

# Git repository (for ArgoCD)
GIT_REPO_URL="https://github.com/your-org/stacks.git"
GIT_BRANCH="main"

# Tailscale tailnet
TAILSCALE_TAILNET="tail123456"

# Optional configuration:
# ────────────────────────────────────────────────────────────────

# ArgoCD Helm chart version
ARGOCD_CHART_VERSION="7.3.0"

# Talos configuration path (default: ~/.talos/config)
# TALOSCONFIG="$HOME/.talos/config"

# Kubeconfig output path
# KUBECONFIG="$HOME/.kube/talos-cluster.yaml"

# CDK8s synthesis concurrency
# SYNTH_CONCURRENCY="4"

# Environment name (for CDK8s synthesis)
# ENVIRONMENT="talos"

# Azure Key Vault secret names (defaults shown):
# ────────────────────────────────────────────────────────────────
# These are the secret names in Azure Key Vault
# Modify only if your Key Vault uses different names

# TAILSCALE_OAUTH_CLIENT_ID_SECRET="TAILSCALE-OAUTH-CLIENT-ID"
# TAILSCALE_OAUTH_CLIENT_SECRET_SECRET="TAILSCALE-OAUTH-CLIENT-SECRET"
# TAILSCALE_AUTH_KEY_SECRET="TAILSCALE-AUTH-KEY"
# GITHUB_APP_PRIVATE_KEY_SECRET="github-app-private-key"
# GITHUB_APP_ID_SECRET="github-app-id"
# GITHUB_APP_INSTALLATION_ID_SECRET="github-app-installation-id"

# Debug options:
# ────────────────────────────────────────────────────────────────

# Enable verbose output
# DEBUG="true"

# Skip JWKS sync (if already configured)
# SKIP_JWKS="true"

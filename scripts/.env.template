# Environment for Talos GitOps Bootstrap
# Feature: 102-bootstrap-talos-argocd
#
# IMPORTANT: This configuration reuses the existing Azure Workload Identity setup
# from wi.env. The federated credentials are already configured for:
# - external-secrets:external-secrets (for Azure Key Vault access)
# - nextjs:acr-sa (for ACR access)
# - kargo:acr-sa (for ACR access)
#
# The same OIDC issuer (oidcissuer65846b7df97b) is used for both Kind and Talos clusters.
# Each cluster syncs its own JWKS to Azure Storage, and Azure AD validates tokens
# based on the JWKS keys. Since different clusters have different signing keys,
# you must sync the JWKS after switching clusters.

# Azure subscription and tenant
AZURE_SUBSCRIPTION_ID="fa5b32b6-1d6d-4110-bea2-8ac0e3126a38"
AZURE_TENANT_ID="0c4da9c5-40ea-4e7d-9c7a-e7308d4f8e38"

# Azure AD Application (for Workload Identity)
# Shared between Kind and Talos clusters - federated credentials already configured
AZURE_CLIENT_ID="1140d9c2-62f6-4857-94c2-7e0e6c64e562"

# Azure Key Vault (secrets storage)
AZURE_KEYVAULT_NAME="keyvault-thcmfmoo5oeow"

# Azure Storage Account (for OIDC JWKS hosting)
# Using oidcissuer65846b7df97b - same as wi.env (federated credentials configured)
AZURE_STORAGE_ACCOUNT="oidcissuer65846b7df97b"

# OIDC Issuer URL (derived from storage account)
SERVICE_ACCOUNT_ISSUER="https://oidcissuer65846b7df97b.z13.web.core.windows.net/"

# Git repository (for ArgoCD)
GIT_REPO_URL="https://github.com/PittampalliOrg/stacks.git"
GIT_BRANCH="102-bootstrap-talos-argocd"

# Tailscale tailnet
TAILSCALE_TAILNET="tail286401"

# ArgoCD Helm chart version
ARGOCD_CHART_VERSION="7.3.0"

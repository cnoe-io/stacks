// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/docker-in-docker
{
	"name": "Docker in Docker",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "docker.io/vpittamp23/ubuntu-nix-backstage:v11",

	"features": {
		"ghcr.io/devcontainers/features/docker-in-docker:2": {
			"version": "latest",
			"enableNonRootDocker": "true",
			"moby": "true"
		},
		"ghcr.io/devcontainers/features/sshd:1": {
			"version": "latest"
		}
	},

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],

	// Use 'postStartCommand' for non-blocking initialization that won't fail the container startup
	"postStartCommand": "bash -c 'echo \"🚀 Initializing home-manager configuration...\" && if [ ! -f ~/.home-manager-initialized ]; then if [ -f /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh ]; then . /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh; elif [ -f ~/.nix-profile/etc/profile.d/nix.sh ]; then . ~/.nix-profile/etc/profile.d/nix.sh; else echo \"⚠️  Nix not found, skipping home-manager initialization\"; exit 0; fi && rm -f ~/.bashrc ~/.profile ~/.bash_profile 2>/dev/null || true && export NIX_CONFIG=\"experimental-features = nix-command flakes\" && nix run home-manager -- switch --flake github:vpittamp/nixos-config#code --impure && touch ~/.home-manager-initialized && echo \"✅ Home-manager initialized!\"; else echo \"✅ Home-manager already initialized.\"; fi || echo \"⚠️  Home-manager initialization skipped\"'"

	// Configure tool-specific properties.
	// "customizations": {},

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}

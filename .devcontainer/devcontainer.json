// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/docker-in-docker
{
	"name": "Docker in Docker",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "docker.io/vpittamp23/ubuntu-nix-backstage:v11",

	"features": {
		"ghcr.io/devcontainers/features/docker-in-docker:2": {
			"version": "latest",
			"enableNonRootDocker": "true",
			"moby": "true"
		},
		"ghcr.io/devcontainers/features/sshd:1": {
			"version": "latest"
		}
	},

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],

	// Use 'postCreateCommand' to run commands after the container is created.
	"postCreateCommand": "bash -c 'echo \"🚀 Initializing home-manager configuration...\" && if [ ! -f ~/.home-manager-initialized ]; then rm -f ~/.bashrc ~/.profile ~/.bash_profile 2>/dev/null || true && . /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh 2>/dev/null || . ~/.nix-profile/etc/profile.d/nix.sh 2>/dev/null && export NIX_CONFIG=\"experimental-features = nix-command flakes\" && nix run home-manager -- switch --flake github:vpittamp/nixos-config#code --impure && touch ~/.home-manager-initialized && echo \"✅ Home-manager initialized!\"; else echo \"✅ Home-manager already initialized.\"; fi'"

	// Configure tool-specific properties.
	// "customizations": {},

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}

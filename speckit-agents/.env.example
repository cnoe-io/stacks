# SpecKit Agents Environment Configuration
# Copy this file to .env and configure for your environment

# =============================================================================
# Agent Identity (Required)
# =============================================================================
AGENT_NAME=orchestrator              # Options: orchestrator, specifier, planner, task-generator, implementer
AGENT_PORT=8000                      # HTTP port for the agent (unique per agent)
AGENT_TOPIC=speckit.orchestrator.requests  # Dapr pub/sub topic for this agent

# =============================================================================
# Team Configuration
# =============================================================================
TEAM_NAME=speckit                    # Agent team name for topic namespacing
BROADCAST_TOPIC=speckit.broadcast    # Topic for team-wide broadcasts
WORKFLOW_STATUS_TOPIC=speckit.workflow.status  # Topic for status updates

# =============================================================================
# Dapr Component Names
# =============================================================================
PUBSUB_NAME=messagepubsub            # Dapr pub/sub component name
WORKFLOW_STATE_STORE=workflowstatestore  # Dapr state store for workflow state
REGISTRY_STATE_STORE=agentregistrystore  # Dapr state store for agent registry
MEMORY_STORE=memorystore             # Dapr state store for conversation memory

# =============================================================================
# Dapr Sidecar Configuration
# =============================================================================
DAPR_HTTP_PORT=3500                  # Dapr sidecar HTTP port
DAPR_GRPC_PORT=50001                 # Dapr sidecar gRPC port

# =============================================================================
# Claude SDK Configuration (Required for LLM agents)
# =============================================================================
ANTHROPIC_API_KEY=sk-ant-xxx         # Anthropic API key (Claude SDK reads directly)
CLAUDE_MODEL=claude-opus-4-5-20251101  # Default model for Claude SDK agents
CLAUDE_MAX_TURNS=10                  # Maximum turns per agent invocation

# =============================================================================
# Langfuse Observability (Optional - graceful degradation if not configured)
# =============================================================================
LANGFUSE_ENABLED=true                # Enable/disable Langfuse tracing
LANGFUSE_HOST=http://langfuse.observability.svc.cluster.local:3000
LANGFUSE_PUBLIC_KEY=pk-lf-xxx        # Project public key from Langfuse dashboard
LANGFUSE_SECRET_KEY=sk-lf-xxx        # Project secret key from Langfuse dashboard

# =============================================================================
# OpenTelemetry / Jaeger Configuration (Optional)
# =============================================================================
OTEL_ENABLED=true                    # Enable/disable OpenTelemetry tracing
OTEL_SERVICE_NAME=speckit-agents     # Service name in Jaeger traces
OTEL_EXPORTER_JAEGER_ENDPOINT=http://jaeger-collector.observability.svc.cluster.local:14268/api/traces
OTEL_EXPORTER_JAEGER_AGENT_HOST=jaeger-agent.observability.svc.cluster.local
OTEL_EXPORTER_JAEGER_AGENT_PORT=6831

# =============================================================================
# Artifact Storage
# =============================================================================
ARTIFACTS_PATH=/artifacts            # Local path for artifact storage (mounted volume)

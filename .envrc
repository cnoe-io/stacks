# Environment Configuration via direnv
# Feature: 106-consolidate-bootstrap-between
#
# This file automatically loads environment variables based on CLUSTER_TYPE
# and applies host-specific OIDC configuration for multi-host deployments.
#
# Usage:
#   CLUSTER_TYPE=kind direnv allow   # For KIND clusters (default)
#   CLUSTER_TYPE=talos direnv allow  # For Talos clusters
#
# Supported hosts: thinkpad, ryzen, hetzner
# Each host has its own OIDC issuer URL to avoid JWKS conflicts.

# Default to 'kind' if CLUSTER_TYPE is not set
export CLUSTER_TYPE="${CLUSTER_TYPE:-kind}"

# Determine which env file to load
ENV_FILE=".env-files/${CLUSTER_TYPE}.env"

if [[ -f "$ENV_FILE" ]]; then
  echo "Loading environment for cluster type: ${CLUSTER_TYPE}"
  dotenv "$ENV_FILE"
else
  echo "Warning: Environment file not found: $ENV_FILE"
  echo "Available cluster types: kind, talos"
  echo "Create the file or set CLUSTER_TYPE to a valid value"
fi

# =============================================================================
# HOST-SPECIFIC OIDC CONFIGURATION
# =============================================================================
# Each host needs its own OIDC issuer URL because:
# 1. Each Kind cluster generates unique signing keys (JWKS)
# 2. Azure AD federated credentials are bound to specific issuer URLs
# 3. Sharing would cause JWKS overwrites between hosts
#
# The Azure Key Vault and other Azure resources can be shared.
# =============================================================================
if [[ "$CLUSTER_TYPE" == "kind" ]]; then
  export CLUSTER_HOST="${CLUSTER_HOST:-$(hostname)}"
  # Provide a deterministic cluster identifier for naming (Tailscale, app scoping, etc.).
  export CLUSTER_NAME="${CLUSTER_NAME:-$CLUSTER_HOST}"

  # Tailscale tailnet domain (shared across all hosts in the same tailnet)
  TAILSCALE_TAILNET="tail286401.ts.net"

  case "$CLUSTER_HOST" in
    thinkpad)
      export AZURE_STORAGE_ACCOUNT="oidcissuer65846b7df97b"
      export SERVICE_ACCOUNT_ISSUER="https://oidcissuer65846b7df97b.z13.web.core.windows.net/"
      # Tailscale Gitea hostname for multi-node clusters (worker nodes can reach this)
      export GITEA_TAILSCALE_HOST="gitea-thinkpad.${TAILSCALE_TAILNET}"
      ;;
    ryzen)
      # TODO: Create Azure resources for ryzen:
      #   az storage account create -n oidcissuerryzen -g rg4 --kind StorageV2
      #   az storage blob service-properties update --account-name oidcissuerryzen --static-website
      #   Add federated credential to Azure AD app for ryzen issuer
      export AZURE_STORAGE_ACCOUNT="oidcissuerryzen"
      export SERVICE_ACCOUNT_ISSUER="https://oidcissuerryzen.z13.web.core.windows.net/"
      export GITEA_TAILSCALE_HOST="gitea-ryzen.${TAILSCALE_TAILNET}"
      ;;
    hetzner)
      # TODO: Create Azure resources for hetzner
      export AZURE_STORAGE_ACCOUNT="oidcissuerhetzner"
      export SERVICE_ACCOUNT_ISSUER="https://oidcissuerhetzner.z13.web.core.windows.net/"
      export GITEA_TAILSCALE_HOST="gitea-hetzner.${TAILSCALE_TAILNET}"
      ;;
    *)
      echo "Warning: Unknown host '$CLUSTER_HOST', using thinkpad defaults"
      export AZURE_STORAGE_ACCOUNT="oidcissuer65846b7df97b"
      export SERVICE_ACCOUNT_ISSUER="https://oidcissuer65846b7df97b.z13.web.core.windows.net/"
      export GITEA_TAILSCALE_HOST="gitea-${CLUSTER_HOST}.${TAILSCALE_TAILNET}"
      ;;
  esac
else
  # For Talos (GitOps), avoid deriving cluster identity from the machine running synthesis.
  # Set CLUSTER_NAME explicitly in the env file/CI if you need per-cluster naming.
  export CLUSTER_NAME="${CLUSTER_NAME:-}"
fi

# Display loaded configuration
if [[ -n "${CLUSTER_HOST:-}" ]]; then
  echo "  Host: $CLUSTER_HOST"
fi
if [[ -n "${CLUSTER_NAME:-}" ]]; then
  echo "  Cluster: $CLUSTER_NAME"
fi
if [[ -n "$AZURE_KEYVAULT_NAME" ]]; then
  echo "  Azure Key Vault: $AZURE_KEYVAULT_NAME"
fi
if [[ -n "$SERVICE_ACCOUNT_ISSUER" ]]; then
  echo "  OIDC Issuer: $SERVICE_ACCOUNT_ISSUER"
fi
if [[ -n "$GIT_REPO_URL" ]]; then
  echo "  Git Repository: $GIT_REPO_URL"
fi
if [[ -n "$GITEA_TAILSCALE_HOST" ]]; then
  echo "  Gitea Tailscale: $GITEA_TAILSCALE_HOST"
fi

# Talos/Hub Cluster Environment Configuration
# Copy this file to talos.env and fill in your values:
#   cp talos.env.template talos.env

# =============================================================================
# Git Configuration (Required)
# =============================================================================
# Repository URL for ArgoCD application sources
GIT_REPO_URL="https://github.com/YOUR_ORG/YOUR_REPO.git"

# Branch to deploy from (default: main)
GIT_BRANCH="main"

# =============================================================================
# Tailscale Configuration (Optional but recommended)
# =============================================================================
# Your Tailscale tailnet name (e.g., "tail286401")
# Find at: https://login.tailscale.com/admin/settings/general
TAILSCALE_TAILNET=""

# =============================================================================
# Azure Workload Identity (Required for ESO)
# =============================================================================
# Azure AD App Registration Client ID
# Find at: Azure Portal → App Registrations → Your App → Overview → Application (client) ID
AZURE_CLIENT_ID=""

# Azure AD Tenant ID
# Find at: Azure Portal → Azure Active Directory → Overview → Tenant ID
AZURE_TENANT_ID=""

# Azure Key Vault name (without .vault.azure.net suffix)
# Find at: Azure Portal → Key Vaults → Your Vault → Overview → Vault name
AZURE_KEYVAULT_NAME=""

# OIDC Issuer URL for Kubernetes ServiceAccount tokens
# This is the Azure Storage static website URL hosting your JWKS
# Find at: Azure Portal → Storage Accounts → Your OIDC Storage → Static website → Primary endpoint
SERVICE_ACCOUNT_ISSUER=""

# =============================================================================
# How to get these values via Azure CLI
# =============================================================================
# az account show --query tenantId -o tsv
# az ad app list --display-name "<app-name>" --query "[0].appId" -o tsv
# az keyvault list --query "[].name" -o tsv
# az storage account list --query "[?contains(name, 'oidc')].primaryEndpoints.web" -o tsv

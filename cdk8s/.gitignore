# CDK8s Generated Files
# dist/ is ignored except for dist/talos/ which is committed for ArgoCD
dist/*
!dist/talos/
.cdk8s.output/

# TypeScript Build Output
*.js
*.d.ts
tsconfig.tsbuildinfo

# Node Modules
node_modules/

# Generated Imports (auto-regenerated by npm run import)
imports/*.ts
imports/*.js

# Exception: kagent CRDs must be committed (not available via public URL)
!imports/kagent.dev.ts

# Temporary Files
*.tmp
*.log

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Talos Cluster Environment Configuration
# Feature: 106-consolidate-bootstrap-between
#
# This file configures the Talos Linux cluster bootstrap.
# Copy from scripts/.env.template and fill in values for your environment.

# =============================================================================
# CLUSTER TYPE (required for unified synthesis)
# =============================================================================
CLUSTER_TYPE=talos

# =============================================================================
# AZURE WORKLOAD IDENTITY (required)
# =============================================================================

# Azure subscription and tenant (required - get from: az account show)
AZURE_SUBSCRIPTION_ID=fa5b32b6-1d6d-4110-bea2-8ac0e3126a38
AZURE_TENANT_ID=0c4da9c5-40ea-4e7d-9c7a-e7308d4f8e38

# Azure AD Application Client ID (for Workload Identity)
AZURE_CLIENT_ID=137fbb08-70ee-4dc3-8f5f-8f61f9571568

# Azure Key Vault name (without .vault.azure.net suffix)
AZURE_KEYVAULT_NAME=keyvault-thcmfmoo5oeow

# Azure Storage Account (for OIDC JWKS hosting)
AZURE_STORAGE_ACCOUNT=oidcissuer04a3332f

# OIDC Issuer URL (derived from storage account)
SERVICE_ACCOUNT_ISSUER=https://oidcissuer04a3332f.z13.web.core.windows.net/

# =============================================================================
# GIT REPOSITORY (required)
# =============================================================================

# Git repository URL for ArgoCD (must be accessible from cluster)
GIT_REPO_URL=https://github.com/PittampalliOrg/stacks.git

# Git branch containing CDK8s manifests
GIT_BRANCH=main

# =============================================================================
# INGRESS CONFIGURATION (required for external access)
# =============================================================================

# Base domain for ingress hosts (e.g., ai401kchat.com)
# Services will be accessible at: argocd.ai401kchat.com, kargo.ai401kchat.com, etc.
INGRESS_HOST=ai401kchat.com

# =============================================================================
# OPTIONAL CONFIGURATION
# =============================================================================

# Tailscale tailnet for remote access (e.g., "tail286401")
TAILSCALE_TAILNET=tail286401

# ArgoCD Helm chart version
ARGOCD_CHART_VERSION=9.4.5

# Environment label
ENVIRONMENT=talos

# =============================================================================
# KIND Cluster Environment Configuration
# =============================================================================
# This file contains environment variables for KIND clusters.
# Host-specific OIDC configuration is handled by .envrc which detects
# the hostname and sets AZURE_STORAGE_ACCOUNT and SERVICE_ACCOUNT_ISSUER.
#
# Supported hosts: thinkpad, ryzen, hetzner
# =============================================================================

# =============================================================================
# AZURE IDENTITY (Shared across all hosts)
# =============================================================================
APP_ID=1140d9c2-62f6-4857-94c2-7e0e6c64e562
AZURE_CLIENT_ID=1140d9c2-62f6-4857-94c2-7e0e6c64e562
AZURE_TENANT_ID=0c4da9c5-40ea-4e7d-9c7a-e7308d4f8e38
AZURE_SUBSCRIPTION_ID=fa5b32b6-1d6d-4110-bea2-8ac0e3126a38
RESOURCE_GROUP=rg4

# Azure Key Vault (shared - same secrets for all hosts)
AZURE_KEYVAULT_NAME=keyvault-thcmfmoo5oeow

# Azure Container Registry (shared)
ACR_NAME=vpittamp
ACR_RG=rg3

# =============================================================================
# HOST-SPECIFIC OIDC CONFIGURATION (defaults - overridden by .envrc)
# =============================================================================
# These are defaults for thinkpad. The .envrc file detects the hostname
# and overrides these for ryzen/hetzner.
#
# Storage accounts per host:
#   thinkpad: oidcissuer65846b7df97b (exists)
#   ryzen:    oidcissuerryzen (TODO: create)
#   hetzner:  oidcissuerhetzner (TODO: create)
#
# Each host needs its own OIDC issuer because each Kind cluster generates
# unique signing keys (JWKS) that Azure AD validates tokens against.
# =============================================================================
AZURE_STORAGE_ACCOUNT=oidcissuer65846b7df97b
SERVICE_ACCOUNT_ISSUER=https://oidcissuer65846b7df97b.z13.web.core.windows.net/
GH_APP_ID=1272071
GH_INSTALLATION_ID=66754705

# Environment Configuration
ENVIRONMENT=dev
CLUSTER_TYPE=kind
NODE_ENV=dev

# Ingress Configuration
ENABLE_TLS=true
TLS_ISSUER=
INGRESS_HOST=cnoe.localtest.me
NEXTJS_BASE_URL=https://chat.cnoe.localtest.me

# Let's Encrypt Configuration (even though TLS is disabled, cert-manager still needs valid email)
ACME_EMAIL=admin@ai401kchat.com

# Backstage Configuration
AUTH_ENVIRONMENT=development
K8S_CLUSTER_NAME=${CLUSTER_HOST:-$(hostname)}
ARGOCD_API_URL=http://argocd-server.argocd:80/api/v1/
# For port-forward access (Microsoft Auth compatible)
BACKSTAGE_BASE_URL=http://localhost:7007
BACKEND_BASE_URL=http://localhost:7007

# Neon Database Configuration
POSTGRES_HOST=ep-wild-heart-a8c6ysmx-pooler.eastus2.azure.neon.tech
POSTGRES_PORT=5432
POSTGRES_USER=neondb_owner
POSTGRES_DATABASE=neondb
POSTGRES_SSL_MODE=require
POSTGRES_CHANNEL_BINDING=require

EXTERNAL_URL=https://ai-platform-engineering.cnoe.localtest.me:8443

# SSH Key Configuration (loaded via synthesize-with-1password.sh script)
# SSH_PUBLIC_KEY is loaded from 1Password at synthesis time via:
# export SSH_PUBLIC_KEY=$(op read "op://Employee/k8s_ed_test/public key")

# Example: Using 1Password secret references
# These will be populated when you use: op run --env-file=.env -- <command>

# Option 1: If using the Employee vault
DEVCONTAINER_SP_CLIENT_SECRET=op://Employee/DEVCONTAINER-SP-CLIENT-SECRET/password

# Option 2: If using the CLI vault (service account)
# DEVCONTAINER_SP_CLIENT_SECRET=op://CLI/DEVCONTAINER-SP-CLIENT-SECRET/password

# To use this:
# 1. With user account: eval $(op signin) && op run --env-file=devcontainer-example.env -- env | grep DEVCONTAINER
# 2. With service account (once token works): export OP_SERVICE_ACCOUNT_TOKEN=<token> && op run --env-file=devcontainer-example.env -- env | grep DEVCONTAINER

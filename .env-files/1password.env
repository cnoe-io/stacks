# 1Password Service Account Token
# This token provides automated access to secrets in the CLI vault
# Token is stored in Azure Key Vault: ONEPASSWORD-SERVICE-ACCOUNT-TOKEN
# 
# To use this file:
# 1. Load the token from Azure Key Vault:
#    export OP_SERVICE_ACCOUNT_TOKEN=$(az keyvault secret show --vault-name keyvault-thcmfmoo5oeow --name ONEPASSWORD-SERVICE-ACCOUNT-TOKEN --query value -o tsv)
# 
# 2. Use op run to inject secrets:
#    op run --env-file=.env-files/1password.env -- env

# Example secret references (these get populated by 'op run')
DEVCONTAINER_SP_CLIENT_SECRET=op://CLI/DEVCONTAINER-SP-CLIENT-SECRET/password

# Add more secret references here as needed
# EXAMPLE_SECRET=op://CLI/EXAMPLE-SECRET-NAME/password
